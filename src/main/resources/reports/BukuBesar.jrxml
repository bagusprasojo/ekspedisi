	<dataset name="tableDataset" uuid="f13e6d36-5148-4ecc-bbe3-3035def80980">
		<query language="sql"><![CDATA[]]></query>
	</dataset>
	<parameter name="REPORT_LOGO" class="java.lang.String"/>
	<parameter name="perkiraan_id" class="java.lang.Integer"/>
	<parameter name="tahun" class="java.lang.Integer"/>
	<parameter name="bulan" class="java.lang.Integer"/>
	<parameter name="tgl_saldo_awal" class="java.util.Date"/>
	<query language="SQL"><![CDATA[select q.*, p.* from (
select 1 as urutan, b.kode, b.nama,  a.tanggal, 'SALDO AWAL' as no_jurnal,'' as keterangan, debet, kredit, 
case 
	when a.saldo_normal = 'DEBET' then  a.debet - a.kredit
	else a.kredit - a.debet
end as saldo_akhir

from closing_perkiraan a
inner join perkiraan b on a.perkiraan_id = b.id
where a.perkiraan_id =  $P{perkiraan_id} 
and date(a.tanggal) = date($P{tgl_saldo_awal})

union all

select 2, e.kode, e.nama, a.tanggal, a.no_jurnal, a.keterangan, b.debet, b.kredit,
case 
	when c.saldo_normal = 'DEBET' then  b.debet - b.kredit
	else b.kredit - b.debet
end as saldo_akhir

from jurnal a
inner join jurnal_detail b on a.id = b.jurnal_id
inner join perkiraan c on b.perkiraan_id = c.id
inner join transaksi_kas d on a.no_jurnal = d.no_bukti
inner join perkiraan e on b.perkiraan_id = e.id
where year(a.tanggal) =  $P{tahun} 
and month(a.tanggal) =  $P{bulan} 
and b.perkiraan_id = $P{perkiraan_id} 
) p 
inner join company q on 1 = 1
order by p.urutan, p.tanggal]]></query>
