	</variable>
	<variable name="saldo_akhir1" resetType="Group" calculation="Sum" resetGroup="GroupInvoice" class="java.math.BigDecimal">
		<expression><![CDATA[$F{saldo_normal} != null && $F{saldo_normal}.equals("DEBET") ? $F{saldo_akhir} : 0]]></expression>
	</variable>
	<variable name="saldo_akhir2" resetType="Group" calculation="Sum" resetGroup="GroupInvoice" class="java.math.BigDecimal">
		<expression><![CDATA[$F{saldo_normal} != null && $F{saldo_normal}.equals("KREDIT") ? $F{saldo_akhir} : 0
]]></expression>
	</variable>
