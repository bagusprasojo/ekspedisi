	<dataset name="tableDataset" uuid="f13e6d36-5148-4ecc-bbe3-3035def80980">
		<query language="sql"><![CDATA[]]></query>
	</dataset>
	<parameter name="REPORT_LOGO" class="java.lang.String"/>
	<parameter name="tahun" class="java.lang.Integer"/>
	<parameter name="bulan" class="java.lang.Integer"/>
	<parameter name="tgl_saldo_awal" class="java.util.Date"/>
	<query language="SQL"><![CDATA[select q.nama_company, q.alamat_company, q.kabupaten_company, q.kode_pos_company, q.provinsi_company , p.kode, p.nama, p.saldo_normal, sum(p.sow_debet) as sow_debet, sum(p.sow_kredit) as sow_kredit, sum(p.debet) as debet, sum(p.kredit) as kredit,
CASE
    WHEN p.saldo_normal = 'DEBET' THEN
      SUM(p.sow_debet) - SUM(p.sow_kredit) + SUM(p.debet) - SUM(p.kredit)
    ELSE
      SUM(p.sow_kredit) - SUM(p.sow_debet) + SUM(p.kredit) - SUM(p.debet)
  END AS saldo_akhir

from 
(
select b.kode, b.nama,  b.saldo_normal, a.debet as sow_debet, a.kredit as sow_kredit, 0 as debet, 0 as kredit 
from closing_perkiraan a
inner join perkiraan b on a.perkiraan_id = b.id
and date(a.tanggal) = date( $P{tgl_saldo_awal} )

union all

select c.kode, c.nama, c.saldo_normal, 0,0,b.debet, b.kredit
from jurnal a
inner join jurnal_detail b on a.id = b.jurnal_id
inner join perkiraan c on b.perkiraan_id = c.id
where year(a.tanggal) =   $P{tahun} 
and month(a.tanggal) =   $P{bulan} 
) p 
inner join company q on 1=1
GROUP BY q.nama_company, q.alamat_company, q.kabupaten_company, q.kode_pos_company, q.provinsi_company , p.kode, p.nama, p.saldo_normal
order by p.kode]]></query>
